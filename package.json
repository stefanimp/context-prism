{
  "name": "context-prism",
  "version": "0.5.0",
  "description": "Creates token-aware context packs from related notes.",
  "main": "main.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "markdown",
    "links",
    "knowledge-management",
    "ai-assistant",
    "context-routing",
    "retrieval",
    "token-optimization",
    "multilingual",
    "obsidian-ai"
  ],
  "author": "Stefan",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.30",
    "esbuild": "^0.25.0",
    "obsidian": "^1.12.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.8"
  }
}
